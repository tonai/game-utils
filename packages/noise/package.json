        "types": "./dist/index.d.cts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts --clean --sourcemap",
    "prepublishOnly": "npm run build",
    "check-exports": "attw --pack ."
  },
  "dependencies": {
    "@tonai/math": "^0.3.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0"
