{
  "name": "@tonai/monorepo",
  "private": true,
  "description": "Monorepo for my utility functions",
  "homepage": "https://github.com/tonai/game-utils",
  "repository": {
    "type": "git",
    "url": "git@github.com:tonai/game-utils.git"
  },
  "bugs": {
    "url": "https://github.com/tonai/game-utils/issues"
  },
  "author": {
    "name": "Tony Cabaye",
    "email": "tonai59+github@gmail.com",
    "url": "https://github.com/tonai"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --ignore-unknown .",
    "check-types": "tsc --noEmit",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "turbo run build && npm run lint && npm run check-types && changeset version",
    "publish": "turbo run build && npm run lint && npm run check-types && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.2.9",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "tsconfig": "^7.0.0",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,ts}": "eslint"
  },
  "packageManager": "npm@10.9.2"
}
